APP_NAME=Tourist Assistant
APP_ENV=production
DATABASE_URL=sqlite:///./tourist_agent.db

# Replace before deploying.
JWT_SECRET=replace-with-a-long-random-secret
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=14

# CORS and host policy.
CORS_ALLOW_ORIGINS=https://your-domain.com
ENABLE_TRUSTED_HOST=true
TRUSTED_HOSTS=your-domain.com,www.your-domain.com

# Production hardening.
CREATE_TABLES_ON_STARTUP=false
DOCS_ENABLED=false
SECURITY_HEADERS_ENABLED=true
HSTS_ENABLED=true

# DeepSeek client (optional for output polish / future function-calling)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_MODEL_FALLBACKS=deepseek-v4-flash,deepseek-v4-pro
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1/chat/completions
DEEPSEEK_POLISH_OUTPUT=false
# quality: higher precision, fast: lower latency
AGENT_SPEED_MODE=quality
AGENT_REASONING_EFFORT=medium
AGENT_ENABLE_THINKING=false
AGENT_ENABLE_QUERY_REWRITE=true
AGENT_MIN_RELEVANCE_SCORE=0.70
AGENT_USE_BATCH_RESULT_ANALYSIS=true
AGENT_FINAL_MAX_TOKENS=2400
AGENT_UNDERSTANDING_MODEL_LONG=deepseek-v4-flash
AGENT_PLANNER_MODEL_LONG=deepseek-v4-flash
AGENT_RESULT_ANALYZER_MODEL_LONG=deepseek-v4-flash
AGENT_FINAL_MODEL_LONG=deepseek-v4-flash
AGENT_ENABLE_PAGE_FETCH=true
AGENT_PAGE_FETCH_MAX_ITEMS=3
AGENT_PAGE_FETCH_WORKERS=4
AGENT_PAGE_FETCH_TIMEOUT_SEC=3.0
